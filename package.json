{
  "name": "@baymaxhit/dsh-idle",
  "version": "0.1.0",
  "description": "Idle-time task scheduler for DeepSeek Harness: queue goal-oriented tasks that run autonomously in their own sessions whenever the host is idle — the off-peak 'watchdog' pattern, as a standalone plugin.",
  "license": "MIT",
  "author": "HUHAN-HIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "harness",
    "plugin",
    "idle",
    "automation"
  ],
  "devDependencies": {
    "@types/node": "22.20.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "packageManager": "pnpm@11.7.0"
}
